ANTHROPIC_API_KEY=
ANTHROPIC_FALLBACK_TO_MOCK=false

# Optional bootstrap defaults. Global settings can be changed later from the Plantillas UI.
GOOGLE_SLIDES_TEMPLATE_ID=
PROPOSAL_TEMPLATE_ID=

# Optional runtime tuning
AGENT_RUNTIME=langgraph
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-6
ANTHROPIC_TIMEOUT_SECONDS=300
PDF_RENDER_TIMEOUT_SECONDS=120

# Used only when AGENT_PLATFORM_TRANSPORT=http. NATS completion is event-driven.
AGENT_PLATFORM_EXECUTION_TIMEOUT=10m
AGENT_PLATFORM_PROPOSAL_EXECUTION_TIMEOUT=30m

# Proposal generation guardrails and estimated Anthropic pricing.
PROPOSAL_CHECKPOINT_TTL_SECONDS=604800
PROPOSAL_INPUT_TOKEN_BUDGET=250000
PROPOSAL_OUTPUT_TOKEN_BUDGET=30000
PROPOSAL_COST_BUDGET_USD=2.0
PROPOSAL_HARD_COST_LIMIT_USD=5.0
ANTHROPIC_INPUT_COST_PER_MILLION_USD=3.0
ANTHROPIC_OUTPUT_COST_PER_MILLION_USD=15.0
ANTHROPIC_CACHE_READ_COST_PER_MILLION_USD=0.30
ANTHROPIC_CACHE_WRITE_COST_PER_MILLION_USD=3.75
